<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dynamic_timesheet_layout_config_form" model="ir.ui.view">
        <field name="name">dynamic.timesheet.layout.config.form</field>
        <field name="model">dynamic.timesheet.layout.config</field>
        <field name="arch" type="xml">
            <form string="Field Display Configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Configuration Name"/>
                        <h1>
                            <field name="name" placeholder=""/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="cluster_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="group_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Write any implementation note here..."/>
                    </group>

                    <notebook>
                        <page string="Field Configuration" name="field_config">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="field_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="technical_name"/>
                                    <field name="field_type"/>
                                    <!--                                    <field name="is_required" invisible="1"/>-->
                                    <!--                                    <field name="is_readonly" invisible="1"/>-->
                                    <field name="line_note"/>
                                    <field name="sequence"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_dynamic_timesheet_layout_config_list" model="ir.ui.view">
        <field name="name">dynamic.timesheet.layout.config.list</field>
        <field name="model">dynamic.timesheet.layout.config</field>
        <field name="arch" type="xml">
            <list string="Field Display Configurations">
                <field name="name"/>
                <field name="cluster_id"/>
                <field name="group_id"/>
            </list>
        </field>
    </record>


    <record id="action_dynamic_timesheet_layout_config" model="ir.actions.act_window">
        <field name="name">Timesheet Layout Configurations</field>
        <field name="res_model">dynamic.timesheet.layout.config</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_dynamic_timesheet_layout_config"
              name="Dynamic Timesheet Fields"
              parent="project.menu_project_config"
              action="action_dynamic_timesheet_layout_config"
              sequence="101"/>
</odoo>
