<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_cluster_list" model="ir.ui.view">
        <field name="name">hr.cluster.list</field>
        <field name="model">hr.cluster</field>
        <field name="arch" type="xml">
            <list string="Clusters">
                <field name="code"/>
                <field name="name"/>
                <field name="manager_id" optional="hide"/>
                <field name="group_count"/>
                <field name="project_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_cluster_form" model="ir.ui.view">
        <field name="name">hr.cluster.form</field>
        <field name="model">hr.cluster</field>
        <field name="arch" type="xml">
            <form string="Cluster">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Button for Groups Count -->
                        <button name="action_view_linked_groups"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cubes">
                            <field name="group_count" widget="statinfo" string="Groups"/>
                        </button>

                        <!-- Button for Projects Count -->
                        <button name="action_view_linked_projects"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-folder-open">
                            <field name="project_count" widget="statinfo" string="Projects"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Cluster Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Production Cluster"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. CL-01"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="manager_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Groups" name="groups">
                            <field name="group_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="manager_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_cluster_search" model="ir.ui.view">
        <field name="name">hr.cluster.search</field>
        <field name="model">hr.cluster</field>
        <field name="arch" type="xml">
            <search string="Search Clusters">
                <field name="name" string="Cluster Name"/>
                <field name="code" string="Cluster Code"/>
                <field name="manager_id" string="Manager"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="groupby_manager" context="{'group_by': 'manager_id'}"/>
                    <filter name="groupby_status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_cluster" model="ir.actions.act_window">
        <field name="name">Clusters</field>
        <field name="res_model">hr.cluster</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Hr Cluster!
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_cluster_root"
              name="Clusters And Groups"
              parent="hr.menu_hr_root"
              sequence="25"/>

    <menuitem id="menu_hr_cluster_action"
              name="Clusters"
              parent="menu_hr_cluster_root"
              action="action_hr_cluster"
              sequence="10"/>

</odoo>
