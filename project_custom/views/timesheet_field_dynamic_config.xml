<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_timesheet_field_dynamic_config_tree" model="ir.ui.view">
        <field name="name">timesheet.field.dynamic.config.tree</field>
        <field name="model">timesheet.field.dynamic.config</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="field_id"/>
                <field name="group_id" options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="view_timesheet_field_dynamic_config_form" model="ir.ui.view">
        <field name="name">timesheet.field.dynamic.config.form</field>
        <field name="model">timesheet.field.dynamic.config</field>
        <field name="arch" type="xml">
            <form string="Config Timesheet Field">
                <sheet>
                    <group>
                        <group>
                            <field name="field_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="group_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_timesheet_field_dynamic_config" model="ir.actions.act_window">
        <field name="name">Config Timesheet Fields</field>
        <field name="res_model">timesheet.field.dynamic.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_timesheet_field_dynamic_config"
              name="Config Timesheet Fields"
              parent="project.menu_project_config"
              action="action_timesheet_field_dynamic_config"
              sequence="100"/>
</odoo>
