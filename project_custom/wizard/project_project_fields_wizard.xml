<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_project_fields_wizard_form" model="ir.ui.view">
        <field name="name">project.project.fields.wizard.form</field>
        <field name="model">project.project.fields.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Visible Fields">
                <sheet>
                    <div class="d-flex align-items-center position-relative mb-3 border rounded bg-white p-2" style="max-width: 100%;">
                        <i class="fa fa-search text-muted me-2" title="Search Icon"/>

                        <field name="search_text"
                               disable_autofocus="1"
                               placeholder="Search fields by label or technical name..."
                               class="border-0 w-100 ps-1"
                               style="outline: none; box-shadow: none; font-size: 14px;"/>
                    </div>
                    <field name="project_id" invisible="1"/>
                    <field name="filtered_line_ids" widget="one2many">
                        <list editable="bottom" create="0" delete="0">
                            <field name="field_description" readonly="1" string="Field Label"/>
                            <field name="field_name" readonly="1" string="Technical Name"/>
                            <field name="is_selected" widget="boolean" string="Show"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Apply Changes" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_project_project_fields_wizard_line_list" model="ir.ui.view">
        <field name="name">project.project.fields.wizard.line.list</field>
        <field name="model">project.project.fields.wizard.line</field>
        <field name="arch" type="xml">
            <list string="Select Visible Fields" editable="bottom" create="0" delete="0">
                <field name="field_description" readonly="1" string="Field Label"/>
                <field name="field_name" readonly="1" string="Technical Name"/>
                <field name="is_selected" string="Show"/>
            </list>
        </field>
    </record>

    <!-- Search View to activate the Filter / Search bar on top of the Popup -->
    <record id="view_project_project_fields_wizard_line_search" model="ir.ui.view">
        <field name="name">project.project.fields.wizard.line.search</field>
        <field name="model">project.project.fields.wizard.line</field>
        <field name="arch" type="xml">
            <search string="Search Fields">
                <field name="field_description" string="Field Label"/>
                <field name="field_name" string="Technical Name"/>
            </search>
        </field>
    </record>

</odoo>
