<templates>

    <t t-name="connes_recruitment.TimesheetLinesListRenderer" t-inherit="web.ListRenderer"
       t-inherit-mode="primary">
        <xpath expr="//CheckBox[contains(@name, 'View Button')]/.." position="after">
            <DropdownItem onSelected="() => this.openSelectFieldsWizard()">
                <i class="fa fa-list-alt me-2 text-primary"/>
                <span class="text-truncate fw-bold">Select Fields (Popup)</span>
            </DropdownItem>

            <DropdownItem onSelected="() => this.exportToExcel()">
                <i class="fa fa-file-excel-o me-2"/>
                <span class="text-truncate">Export to Excel</span>
            </DropdownItem>
        </xpath>
    </t>

</templates>
