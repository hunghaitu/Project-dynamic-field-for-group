<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="connes_recruitment_view_form" model="ir.ui.view">
        <field name="name">connes_recruitment_view_form</field>
        <field name="model">connes.recruitment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Send" type="object" name="action_send" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Approve" type="object" name="action_approve" class="btn-success"
                            invisible="not (state in ('manager_approve'))"/>
                    <button string="Reject" type="object" name="action_reject" class="btn-danger"
                            invisible="not (state in ('manager_approve'))"/>
                    <button string="Reset Draft" type="object" name="action_reset_draft" class="btn-secondary"
                            invisible="state != 'manager_approve'"/>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group col="2">
                        <group>
                            <field name="name"/>
                            <field name="requested_by"/>
                            <field name="recipients" widget="many2many_tags"/>
                            <field name="project_owner"/>
                            <field name="type_of_request" widget="radio"/>
                        </group>
                        <group col="1">
                            <group string="Process Details">
                                <field name="existing_process"
                                       invisible="type_of_request ==  'start_lob'"
                                       required="type_of_request !=  'start_lob'"/>
                                <field name="description"
                                       invisible="type_of_request ==  'start_lob'"
                                       required="type_of_request !=  'start_lob'"/>
                                <field name="new_process_name"
                                       invisible="type_of_request !=  'start_lob'"
                                       required="type_of_request ==  'start_lob'"/>
                            </group>
                            <group string="Headcount Details">
                                <field name="current_headcount"/>
                                <field name="headcount_change"/>
                                <field name="total_desired_headcount"/>
                                <field name="effective_date"/>
                            </group>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="connes_recruitment_view_tree" model="ir.ui.view">
        <field name="name">connes_recruitment_view_tree</field>
        <field name="model">connes.recruitment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="requested_by"/>
                <field name="state"/>
                <field name="effective_date"/>
                <field name="project_owner"/>
            </list>
        </field>
    </record>

    <record id="connes_recruitment_action" model="ir.actions.act_window">
        <field name="name">Cennos - Headcount Change Form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">connes.recruitment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="connes_recruitment_menu"
              name="Headcount Change"
              parent="hr_recruitment.menu_hr_recruitment_root"
              action="connes_recruitment_action"
              sequence="3"/>
</odoo>
