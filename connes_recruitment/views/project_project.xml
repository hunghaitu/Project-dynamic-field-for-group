<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_project_form_inherited" model="ir.ui.view">
        <field name="name">project.project.form.inherited.connes</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='label_tasks']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="manager_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="code"/>
                <field name="cluster_id"/>
                <field name="group_id"/>
                <field name="project_unit_id"/>
            </xpath>
            <xpath expr="//field[@name='date']" position="after">
                <field name="actual_start_date"/>
                <field name="actual_completion_date"/>
            </xpath>
            <xpath expr="//page[@name='description']" position="after">
                <page name="productivity" string="Productivity Planning">
                    <group>
                        <group>
                            <field name="productivity_goal"/>
                            <field name="estimated_productivity"/>
                            <field name="estimated_hours_remaining"/>
                        </group>
                        <group>
                            <field name="productivity_unit_id"/>
                            <field name="estimated_completion_hours"/>
                        </group>
                    </group>
                </page>
                <page name="kpi" string="Project KPI">
                    <group>
                        <group>
                            <field name="quantity_completed"/>
                            <field name="total_hours_log_internal"/>
                            <field name="total_hours_log"/>
                        </group>
                        <group>
                            <field name="actual_productivity"/>
                            <field name="actual_tat"/>
                            <field name="week_completed"/>
                            <field name="month_completed"/>
                        </group>
                    </group>
                </page>
                <page name="internal_timesheet" string="Internal Timesheets">
                </page>
                <page name="public_timesheet" string="Public Timesheets">
                </page>
                <page name="flex_in_out" string="Flex in-out">
                </page>
                <page name="stakeholders" string="Stakeholders">
                    <group>
                        <group>
                            <field name="poc_ids" widget="many2many_tags"/>
                            <field name="supervisor_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="manager_ids" widget="many2many_tags"/>
                            <field name="leader_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_project_project_list_inherit" model="ir.ui.view">
        <field name="name">project.project.list.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <field name="code" string="Project ID" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='name']" position="after">
                <field name="cluster_id" optional="show"/>
                <field name="group_id" optional="show"/>
                <field name="manager_ids" widget="many2many_tags" optional="show"/>
                <field name="stage_id" string="Project Status" optional="show"/>
                <field name="task_count_list" string="Tasks" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_project_project_filter_inherit" model="ir.ui.view">
        <field name="name">project.project.select.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="replace"/>
            <xpath expr="//field[@name='name']" position="after">
                <field name="code" string="Project ID"/>
                <field name="manager_ids" string="Project Manager" operator="child_of"/>
                <field name="cluster_id"/>
                <field name="group_id"/>
            </xpath>
            <xpath expr="//filter[@name='Manager']" position="replace">
                <filter name="groupby_manager" context="{'group_by': 'manager_ids'}"/>
            </xpath>

            <xpath expr="//group" position="inside">
                <filter name="groupby_cluster" context="{'group_by': 'cluster_id'}"/>
                <filter name="groupby_group" context="{'group_by': 'group_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
