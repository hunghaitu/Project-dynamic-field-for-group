<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Search View -->
    <record id="view_overtime_category_search" model="ir.ui.view">
        <field name="name">overtime.category.search</field>
        <field name="model">overtime.category</field>
        <field name="arch" type="xml">
            <search string="Search OT Categories">
                <field name="code" string="OT Category Code"/>
                <field name="name" string="OT Category Name"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="groupby_status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 2. List View -->
    <record id="view_overtime_category_list" model="ir.ui.view">
        <field name="name">overtime.category.list</field>
        <field name="model">overtime.category</field>
        <field name="arch" type="xml">
            <list string="OT Categories" multi_edit="1">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- 3. Form View -->
    <record id="view_overtime_category_form" model="ir.ui.view">
        <field name="name">overtime.category.form</field>
        <field name="model">overtime.category</field>
        <field name="arch" type="xml">
            <form string="OT Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. OT Weekly"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="code" placeholder="e.g. OTW"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description / Note" name="description_page">
                            <field name="description" placeholder="Specify details or notes about this overtime category..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 4. Action -->
    <record id="action_overtime_category" model="ir.actions.act_window">
        <field name="name">OT Categories</field>
        <field name="res_model">overtime.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_overtime_category_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new OT Category
            </p>
            <p>
                Define different classes of overtime rules to apply across timesheets.
            </p>
        </field>
    </record>

    <!-- 5. Menuitem -->
    <menuitem id="hr_timesheet.hr_timesheet_menu_configuration"
              name="Configuration"
              parent="hr_timesheet.timesheet_menu_root"
              sequence="100"/>
    <menuitem id="menu_timesheet_settings_action"
              name="Settings"
              parent="hr_timesheet.hr_timesheet_menu_configuration"
              action="hr_timesheet.hr_timesheet_config_settings_action"
              sequence="10"/>
    <menuitem id="menu_overtime_category"
              name="OT Categories"
              parent="hr_timesheet.hr_timesheet_menu_configuration"
              action="action_overtime_category"
              sequence="45"/>
</odoo>
