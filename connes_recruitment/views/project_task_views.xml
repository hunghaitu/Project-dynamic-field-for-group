    <record id="view_project_task_filter_inherit" model="ir.ui.view">
        <field name="name">project.task.search.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form_base"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="code"/>
                <field name="task_category_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="groupby_task_category_id" context="{'group_by': 'task_category_id'}"/>
            </xpath>
        </field>
    </record>

