<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_project_task_rework_form" model="ir.ui.view">
        <field name="name">project.task.rework.form</field>
        <field name="model">project.task.rework</field>
        <field name="arch" type="xml">
            <form string="Task Rework Request">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="open,resubmitted,closed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Basic Information">
                            <field name="task_id" readonly="1"/>
                            <field name="rework_no" readonly="1"/>
                            <field name="submission_id" domain="[('task_id', '=', task_id)]"/>
                            <field name="rework_reason_id"/>
                        </group>
                        <group string="Audit &amp; Timeline">
                            <field name="requested_by_id"/>
                            <field name="requested_date"/>
                            <field name="resubmitted_date"/>
                        </group>
                    </group>

                    <group string="Rework Note">
                        <field name="rework_note" nolabel="1" colspan="2" placeholder="Provide details on why this task requires rework..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
