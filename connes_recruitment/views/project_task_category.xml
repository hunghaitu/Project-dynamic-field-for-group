<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_category_search" model="ir.ui.view">
        <field name="name">project.task.category.search</field>
        <field name="model">project.task.category</field>
        <field name="arch" type="xml">
            <search string="Search Task Categories">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="groupby_status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_project_task_category_list" model="ir.ui.view">
        <field name="name">project.task.category.list</field>
        <field name="model">project.task.category</field>
        <field name="arch" type="xml">
            <list string="Task Categories" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_project_task_category_form" model="ir.ui.view">
        <field name="name">project.task.category.form</field>
        <field name="model">project.task.category</field>
        <field name="arch" type="xml">
            <form string="Task Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Core Work"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="code" placeholder="e.g. CORE"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description_page">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_task_category" model="ir.actions.act_window">
        <field name="name">Task Categories</field>
        <field name="res_model">project.task.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_task_category_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Task Category
            </p>
            <p>
                Task categories allow you to group your tasks under specific labels (e.g., Core Work, Support, Research).
            </p>
        </field>
    </record>

    <menuitem id="menu_project_task_category"
              name="Task Categories"
              parent="project.menu_project_config"
              action="action_project_task_category"
              sequence="25"/>
</odoo>
