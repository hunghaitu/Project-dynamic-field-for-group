<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Search View -->
    <record id="view_flex_reason_search" model="ir.ui.view">
        <field name="name">flex.reason.search</field>
        <field name="model">flex.reason</field>
        <field name="arch" type="xml">
            <search string="Search Flex Reasons">
                <field name="code" string="Flex Reason Code"/>
                <field name="name" string="Flex Reason Name"/>

                <separator/>

                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>

                <separator/>

                <!-- Odoo 19 clean syntax: No string attributes inside group and filter tags -->
                <group>
                    <filter name="groupby_status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 2. List View -->
    <record id="view_flex_reason_list" model="ir.ui.view">
        <field name="name">flex.reason.list</field>
        <field name="model">flex.reason</field>
        <field name="arch" type="xml">
            <list string="Flex Reasons" multi_edit="1">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- 3. Form View -->
    <record id="view_flex_reason_form" model="ir.ui.view">
        <field name="name">flex.reason.form</field>
        <field name="model">flex.reason</field>
        <field name="arch" type="xml">
            <form string="Flex Reason">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Work Shortage - Lack of core work"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="code" placeholder="e.g. 1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description / Note" name="description_page">
                            <field name="description" placeholder="Describe the meaning and scope of use for this Flex Reason..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 4. Action -->
    <record id="action_flex_reason" model="ir.actions.act_window">
        <field name="name">Flex Reasons</field>
        <field name="res_model">flex.reason</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_flex_reason_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Flex Reason
            </p>
            <p>
                Define reasons for non-standard working hours or flexibility inside tasks.
            </p>
        </field>
    </record>

    <!-- 5. Menuitem inside Project Configuration -->
    <menuitem id="menu_flex_reason"
              name="Flex Reasons"
              parent="hr_timesheet.hr_timesheet_menu_configuration"
              action="action_flex_reason"
              sequence="50"/>
</odoo>
