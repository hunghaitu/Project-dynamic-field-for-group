<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_unit_search" model="ir.ui.view">
        <field name="name">project.unit.search</field>
        <field name="model">project.unit</field>
        <field name="arch" type="xml">
            <search string="Search Project Units">
                <field name="code" string="Unit Code"/>
                <field name="name" string="Unit Name"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="groupby_status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_project_unit_list" model="ir.ui.view">
        <field name="name">project.unit.list</field>
        <field name="model">project.unit</field>
        <field name="arch" type="xml">
            <list string="Units" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_project_unit_form" model="ir.ui.view">
        <field name="name">project.unit.form</field>
        <field name="model">project.unit</field>
        <field name="arch" type="xml">
            <form string="Unit">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Task"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="code" placeholder="e.g. TASK"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description / Note" name="description_page">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">project.unit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_unit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Unit
            </p>
            <p>
                Sequence controls display order. Archived units remain in historical records but are not available for new Task selection.
            </p>
        </field>
    </record>

    <menuitem id="menu_project_unit"
              name="Units"
              parent="project.menu_project_config"
              action="action_project_unit"
              sequence="30"/>
</odoo>
