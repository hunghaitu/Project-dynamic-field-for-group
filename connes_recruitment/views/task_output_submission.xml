<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_output_submission_form" model="ir.ui.view">
        <field name="name">task.output.submission.form</field>
        <field name="model">task.output.submission</field>
        <field name="arch" type="xml">
            <form string="New Output Submission">
                <header>
                    <field name="submission_status" widget="statusbar" statusbar_visible="draft,submitted,reviewed"/>
                </header>
                <sheet>
                    <group string="Output Links">
                        <field name="output_link_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="name" string="LINK NAME" placeholder="Link Name"/>
                                <field name="url" widget="url" string="URL" placeholder="https://..."/>
                                <field name="note" string="NOTE" placeholder="Note"/>
                            </list>
                        </field>
                    </group>
                    <group string="Output Attachments">
                        <field name="attachment_ids" widget="many2many_binary" colspan="2"/>
                    </group>
                    <group string="Output Note">
                        <field name="output_note" nolabel="1" colspan="2"/>
                    </group>

                    <div class="alert alert-info border-start border-4 border-info mt-3 mb-2" role="alert">
                        <p class="mb-0">
                            QA/TL review access is inherited from the current Project. When the Agent submits, the system notifies the authorized QA/TL scope; no reviewer is
                            selected on this form.
                        </p>
                    </div>
                    <div class="text-muted small">
                        Draft is editable by the Agent. Submitted output is locked. Only QA/TL users authorized on the Project can review it. QA Result is set through Approve,
                        Request Rework or Reject.
                    </div>
                </sheet>
                <footer>
                    <button string="Send To QA"
                            name="action_submit_for_qa"
                            type="object"
                            class="btn-primary"
                            invisible="submission_status != 'draft'"/>
                    <button string="Save" class="btn-secondary" special="save"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
