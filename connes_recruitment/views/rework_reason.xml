<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Search View -->
    <record id="view_rework_reason_search" model="ir.ui.view">
        <field name="name">rework.reason.search</field>
        <field name="model">rework.reason</field>
        <field name="arch" type="xml">
            <search string="Search Rework Reasons">
                <field name="code" string="Rework Reason Code"/>
                <field name="name" string="Rework Reason Name"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="groupby_status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 2. List View -->
    <record id="view_rework_reason_list" model="ir.ui.view">
        <field name="name">rework.reason.list</field>
        <field name="model">rework.reason</field>
        <field name="arch" type="xml">
            <list string="Rework Reasons" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- 3. Form View -->
    <record id="view_rework_reason_form" model="ir.ui.view">
        <field name="name">rework.reason.form</field>
        <field name="model">rework.reason</field>
        <field name="arch" type="xml">
            <form string="Rework Reason">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Missing Info"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="code" placeholder="e.g. MISSING_INFO"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description / Note" name="description_page">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 4. Action -->
    <record id="action_rework_reason" model="ir.actions.act_window">
        <field name="name">Rework Reasons</field>
        <field name="res_model">rework.reason</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rework_reason_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Rework Reason
            </p>
            <p>
                Define standard reasons why a task has to be reworked.
            </p>
        </field>
    </record>

    <menuitem id="menu_rework_reason"
              name="Rework Reasons"
              parent="project.menu_project_config"
              action="action_rework_reason"
              sequence="40"/>
</odoo>
